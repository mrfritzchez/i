local ThemeManager = {}
ThemeManager.__index = ThemeManager

function ThemeManager.new()
    local self = setmetatable({}, ThemeManager)
    self.CurrentTheme = Themes.Default
    self.CustomThemes = {}
    self.ThemeChanged = Instance.new("BindableEvent")
    return self
end

function ThemeManager:GetTheme(name)
    return Themes[name] or self.CustomThemes[name]
end

function ThemeManager:SetTheme(name)
    local theme = self:GetTheme(name)
    if theme then
        self.CurrentTheme = theme
        self.ThemeChanged:Fire(theme)
        return true
    end
    return false
end

function ThemeManager:RegisterCustomTheme(name, theme)
    self.CustomThemes[name] = theme
end

function ThemeManager:GetAllThemes()
    local list = {}
    for name, _ in pairs(Themes) do
        table.insert(list, name)
    end
    for name, _ in pairs(self.CustomThemes) do
        table.insert(list, name)
    end
    return list
end

function ThemeManager:CreateThemeFromBase(baseName, modifications)
    local base = self:GetTheme(baseName)
    if not base then return nil end

    local newTheme = {}
    for key, value in pairs(base) do
        newTheme[key] = modifications[key] or value
    end

    return newTheme
end

function ThemeManager:ExportTheme(name)
    local theme = self:GetTheme(name)
    if not theme then return nil end

    local export = {}
    for key, value in pairs(theme) do
        if typeof(value) == "Color3" then
            export[key] = {
                type = "Color3",
                r = value.R,
                g = value.G,
                b = value.B
            }
        else
            export[key] = value
        end
    end

    return game:GetService("HttpService"):JSONEncode(export)
end

function ThemeManager:ImportTheme(name, jsonData)
    local data = game:GetService("HttpService"):JSONDecode(jsonData)
    local theme = {}

    for key, value in pairs(data) do
        if type(value) == "table" and value.type == "Color3" then
            theme[key] = Color3.new(value.r, value.g, value.b)
        else
            theme[key] = value
        end
    end

    self:RegisterCustomTheme(name, theme)
    return theme
end

